{
  "name": "feagi",
  "version": "0.1.1",
  "description": "Inspect, build, wire, test, and debug brains in a running FEAGI instance. Bundles the feagi MCP server and a skill covering FEAGI concepts, circuit-building policy, connectivity, memory and plasticity, embodiment, and diagnostics.",
  "author": {
    "name": "Neuraville Inc.",
    "email": "feagi@neuraville.com",
    "url": "https://neuraville.com"
  },
  "homepage": "https://feagi.org",
  "repository": "https://github.com/feagi/feagi-mcp",
  "license": "Apache-2.0",
  "keywords": ["feagi", "neuroscience", "spiking-neural-network", "robotics", "neurorobotics", "mujoco", "mcp"],
  "mcpServers": {
    "feagi": {
      "command": "uvx",
      "args": ["feagi-mcp@0.1.1"],
      "env": {
        "FEAGI_HOST": "${FEAGI_HOST:-localhost}",
        "FEAGI_PORT": "${FEAGI_PORT:-8000}"
      }
    }
  }
}
