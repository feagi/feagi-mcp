{
  "format": "nrs.body_datasheet_fixtures/1",
  "note": "One shared fixture for the four datasheet validators (feagi-mcp, nrs-composer, feagi-desktop, feagi-react-core-pro). Each case is a datasheet author document. valid=false means a validator must refuse it with an error whose path or text contains error_path. Single home: nrs-embodiments/schemas; byte-equal copies in the four repos.",
  "cases": [
    {
      "name": "valid_full_serial_arm",
      "datasheet": {
        "format": "feagi.datasheet/1",
        "body": {
          "format": "nrs.body/1",
          "roles_version": "1.0",
          "family": "serial_arm",
          "mount": "table_top_upright",
          "use_cases": [
            "pick_and_place"
          ],
          "joints_used": [
            "arm.base_yaw",
            "arm.shoulder_pitch",
            "arm.elbow_bend",
            "arm.wrist_flexion"
          ],
          "joints_required": [
            "arm.shoulder_pitch",
            "arm.elbow_bend"
          ],
          "gripper": "optional",
          "home_deg": {
            "arm.shoulder_pitch": 20,
            "arm.elbow_bend": 0
          },
          "seeds": [
            {
              "slot": 1,
              "move_id": "reach_low_left",
              "pose_deg": {
                "arm.base_yaw": -30,
                "arm.elbow_bend": 70
              }
            },
            {
              "slot": 2,
              "move_id": "reach_low_right",
              "pose_deg": {
                "arm.base_yaw": 30,
                "arm.elbow_bend": 70
              }
            }
          ]
        }
      },
      "valid": true,
      "error_path": null
    },
