# FEAGI MCP Server Configuration
# Copy this to .env in the project root and customize as needed

# FEAGI connection settings
FEAGI_HOST=localhost
FEAGI_PORT=8000

# Request timeout (seconds)
FEAGI_TIMEOUT_SECONDS=30.0

# Connection retry settings
FEAGI_MAX_RETRIES=3
FEAGI_CONNECTION_CHECK_INTERVAL_SECONDS=5.0
